{
  "$schema": "https://docs.openclaw.ai/plugins/schema/channel-config.json",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "启用/禁用 openchat-wechat channel"
    },
    "allowFrom": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "白名单用户 ID（留空 = 允许所有人）"
    },
    "dmPolicy": {
      "type": "string",
      "enum": ["allowlist", "open", "disabled"],
      "default": "allowlist",
      "description": "DM 策略"
    },
    "defaultAgent": {
      "type": "string",
      "default": "build",
      "description": "默认 openclaw agent 类型"
    },
    "defaultModel": {
      "type": "string",
      "default": "",
      "description": "默认模型 ID（provider/model）"
    },
    "systemPrompt": {
      "type": "string",
      "default": "",
      "description": "可选的系统提示词（注入到每条消息）"
    },
    "systemPromptFile": {
      "type": "string",
      "default": "",
      "description": "可选的系统提示词文件路径"
    },
    "botAgent": {
      "type": "string",
      "default": "openchat-wechat/0.1.0",
      "description": "bot_agent header（用于微信后台日志归因）"
    }
  }
}
